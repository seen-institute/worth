# Downloaded CMS source files. Fetched and hashed at runtime, never committed.
# These default to ~/.cache/worth/cms; this covers WORTH_CACHE_DIR pointed here.
.cache/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
build/
dist/

# Tooling
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Editors / OS
.DS_Store
.idea/
.vscode/

# the console's dependencies and build output
node_modules/
app/dist/
*.tsbuildinfo
