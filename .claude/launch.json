{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "console",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "app", "run", "dev", "--", "--port", "5173", "--strictPort"],
      "port": 5173
    },
    {
      "name": "api",
      "runtimeExecutable": "uv",
      "runtimeArgs": ["run", "uvicorn", "worth_api.main:create_app", "--factory", "--port", "8000"],
      "port": 8000
    },
    {
      "name": "api-db",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "docker compose up -d --wait db && DATABASE_URL=postgresql://worth:worth@127.0.0.1:55432/worth uv run uvicorn worth_api.main:create_app --factory --port 8000"
      ],
      "port": 8000
    }
  ]
}
