{
  "rule_pack_id": "gyn-surgical",
  "version": "1",
  "status": "provisional",
  "status_note": "Weights and anchors below are a mine and Claude's placeholder. The methodology requires that weights be set by clinical advisory input and statistical analysis of which markers predict resource intensity, not by assertion. Until that work is done, no index computed with this pack should be published.",
  "normalisation": "fixed-anchor",
  "normalisation_note": "Each marker is normalised against fixed anchors published in this file, never against percentiles of the observed cohort. An empirically normalised score changes every time an encounter is added, which would make a published value non-comparable with itself a month later. Fixed anchors cost some dynamic range and buy stability.",
  "lanes_note": "Structured markers carry 0.74 of the weight and narrative rules 0.26. Where both lanes offer the same marker the structured value wins, because a score that preferred narrative would measure how thoroughly a surgeon writes rather than how hard the case was.",
  "markers": [
    {
      "marker_id": "operative_minutes",
      "provenance": "structured",
      "weight": "0.22",
      "anchor_low": "30",
      "anchor_high": "240",
      "note": "Incision to close, not in-room to out-of-room. Turnover and positioning are real work but they are not the surgeon's operative effort, and in-room time is the more easily gamed of the two. The note usually restates the time; OpTime wins where both exist.",
      "narrative": {
        "aggregate": "numeric",
        "note_types": [
          "operative"
        ],
        "sections": [
          "total operative time",
          "operative time"
        ],
        "excluded_sections": [
          "preamble"
        ],
        "patterns": [
          {
            "id": "minutes",
            "regex": "(\\d{2,4})\\s*(?:minutes|min)\\b"
          },
          {
            "id": "hours",
            "scale": "60",
            "regex": "(\\d{1,2})\\s*hours?\\b"
          }
        ]
      }
    },
    {
      "marker_id": "asa_class",
      "provenance": "structured",
      "weight": "0.11",
      "anchor_low": "1",
      "anchor_high": "4",
      "note": "ASA physical status. Published ordinal instrument, assigned pre-operatively by anaesthesia, independent of the surgeon and of billing."
    },
    {
      "marker_id": "distinct_surgical_specialties",
      "provenance": "structured",
      "weight": "0.11",
      "anchor_low": "1",
      "anchor_high": "3",
      "note": "Count of distinct specialties among operating surgeons. A colorectal team in a gynaecological case is the clearest structured signal that the case exceeded what the code contemplates."
    },
    {
      "marker_id": "estimated_blood_loss_ml",
      "provenance": "structured",
      "weight": "0.07",
      "anchor_low": "0",
      "anchor_high": "600",
      "narrative": {
        "aggregate": "numeric",
        "note_types": [
          "operative"
        ],
        "sections": [
          "estimated blood loss",
          "ebl"
        ],
        "excluded_sections": [
          "preamble"
        ],
        "patterns": [
          {
            "id": "millilitres",
            "regex": "(\\d{1,5})\\s*(?:ml|cc)\\b"
          }
        ]
      },
      "note": "Discrete field where the OR record carries one, the note's own statement where it does not."
    },
    {
      "marker_id": "procedure_count",
      "provenance": "structured",
      "weight": "0.07",
      "anchor_low": "1",
      "anchor_high": "3",
      "note": "Distinct CPT codes on the operative log. Counted from documentation, not from what was submitted, so an uncoded procedure still raises complexity."
    },
    {
      "marker_id": "comorbidity_count",
      "provenance": "structured",
      "weight": "0.08",
      "anchor_low": "0",
      "anchor_high": "6"
    },
    {
      "marker_id": "assistant_surgeon_count",
      "provenance": "structured",
      "weight": "0.04",
      "anchor_low": "0",
      "anchor_high": "2"
    },
    {
      "marker_id": "inpatient",
      "provenance": "structured",
      "weight": "0.04",
      "anchor_low": "0",
      "anchor_high": "1"
    },
    {
      "marker_id": "anatomic_extent",
      "provenance": "rule",
      "weight": "0.10",
      "anchor_low": "0",
      "anchor_high": "4",
      "note": "Distinct structures involved beyond the primary operative field. Read from the findings and the operative description only: an organ named under INDICATION is why the patient is in theatre, not work performed today.",
      "narrative": {
        "aggregate": "count_distinct",
        "note_types": [
          "operative"
        ],
        "sections": [
          "findings",
          "description of procedure",
          "procedure in detail"
        ],
        "excluded_sections": [
          "indication",
          "indications",
          "history",
          "past surgical history",
          "past medical history",
          "review of systems",
          "family history",
          "preoperative diagnosis",
          "plan",
          "disposition",
          "preamble"
        ],
        "patterns": [
          {
            "id": "bowel",
            "value": "1",
            "regex": "\\b(?:rectosigmoid|recto-sigmoid|sigmoid colon|large bowel|small bowel|bowel wall|rectal wall|rectovaginal septum)\\b"
          },
          {
            "id": "ureter",
            "value": "1",
            "regex": "\\bureter(?:s|al|olysis)?\\b"
          },
          {
            "id": "bladder",
            "value": "1",
            "regex": "\\b(?:bladder|vesicouterine|vesical)\\b"
          },
          {
            "id": "diaphragm",
            "value": "1",
            "regex": "\\bdiaphragm(?:atic)?\\b"
          },
          {
            "id": "appendix",
            "value": "1",
            "regex": "\\bappendi(?:x|ceal|cectomy)\\b"
          },
          {
            "id": "omentum",
            "value": "1",
            "regex": "\\bomentum|omental\\b"
          },
          {
            "id": "sidewall",
            "value": "1",
            "regex": "\\bpelvic sidewall\\b"
          }
        ]
      }
    },
    {
      "marker_id": "adhesion_severity",
      "provenance": "rule",
      "weight": "0.09",
      "anchor_low": "0",
      "anchor_high": "3",
      "note": "Crude ordinal from explicit phrasing: dense 3, moderate 2, filmy 1. The methodology reserves the severity a rule cannot reach -- a note that never uses the word -- for the generative enrichment lane. This reads only what is written.",
      "narrative": {
        "aggregate": "max_value",
        "note_types": [
          "operative"
        ],
        "sections": [
          "findings",
          "description of procedure",
          "procedure in detail"
        ],
        "excluded_sections": [
          "indication",
          "indications",
          "history",
          "past surgical history",
          "past medical history",
          "preoperative diagnosis",
          "plan",
          "preamble"
        ],
        "patterns": [
          {
            "id": "dense",
            "value": "3",
            "regex": "\\b(?:dense (?:and )?(?:filmy )?adhesion|densely adherent|extensive adhesiolysis|frozen pelvis|obliterated (?:posterior )?cul-de-sac|grade (?:3|4|III|IV) adhesion)"
          },
          {
            "id": "moderate",
            "value": "2",
            "regex": "\\b(?:moderate adhesion|fibrous adhesion|adhesiolysis|lysis of adhesion)"
          },
          {
            "id": "filmy",
            "value": "1",
            "regex": "\\b(?:filmy adhesion|few adhesion|minimal adhesion|thin adhesion)"
          }
        ]
      }
    },
    {
      "marker_id": "intraoperative_events",
      "provenance": "rule",
      "weight": "0.07",
      "anchor_low": "0",
      "anchor_high": "3",
      "note": "Events that occurred during the case. Distinct kinds, not occurrences: two serosal tears are one kind of event.",
      "narrative": {
        "aggregate": "count_distinct",
        "note_types": [
          "operative"
        ],
        "sections": [
          "description of procedure",
          "procedure in detail",
          "findings",
          "complications"
        ],
        "excluded_sections": [
          "indication",
          "indications",
          "history",
          "past surgical history",
          "preoperative diagnosis",
          "plan",
          "disposition",
          "preamble"
        ],
        "patterns": [
          {
            "id": "conversion",
            "value": "1",
            "regex": "\\b(?:converted to (?:an )?open|conversion to (?:an )?open|open laparotomy was performed)\\b"
          },
          {
            "id": "transfusion",
            "value": "1",
            "regex": "\\b(?:transfus(?:ed|ion)|packed red blood cells|units? of PRBC)\\b"
          },
          {
            "id": "visceral_injury",
            "value": "1",
            "regex": "\\b(?:enterotomy|cystotomy|ureteral injury|serosal (?:tear|injury)|visceral injury|inadvertent (?:entry|injury))\\b"
          },
          {
            "id": "intraoperative_consult",
            "value": "1",
            "regex": "\\b(?:intraoperative consultation|called intraoperatively|consulted intraoperatively)\\b"
          }
        ]
      }
    }
  ]
}
